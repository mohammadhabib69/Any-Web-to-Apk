<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ═══ INTERNET permission — required for loading websites & serving ads ═══ -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ═══ Optional: ACCESS_NETWORK_STATE — used by AdMob to check connectivity ═══ -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Poki"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- ═══ AdMob App ID — REQUIRED if you use AdMob ads ═══ -->
        <!-- Replace the value below with your real AdMob App ID from https://admob.google.com -->
        <!-- For TESTING, keep the sample App ID below. For PRODUCTION, use your own. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        <!-- ↑ Replace with your AdMob App ID (NOT the Ad Unit ID — this is the APP-level ID) -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@style/Theme.Poki">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>